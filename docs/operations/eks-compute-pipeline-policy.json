{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRuntimeCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "CreateTaggedRuntimeCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "fiapx",
          "aws:RequestTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupInOwnedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "fiapx",
          "ec2:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "TagNewRuntimeCompute",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "fiapx",
          "aws:RequestTag/ManagedBy": "terraform",
          "ec2:CreateAction": [
            "CreateLaunchTemplate",
            "CreateSecurityGroup"
          ]
        }
      }
    },
    {
      "Sid": "UpdateOwnedLaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "fiapx",
          "ec2:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "RevokeOwnedApiGroupDefaultEgress",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "fiapx",
          "ec2:ResourceTag/ManagedBy": "terraform",
          "ec2:ResourceTag/Name": "fiapx-eks-private-api"
        }
      }
    },
    {
      "Sid": "MaintainOwnedRuntimeTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/Project": "fiapx",
          "ec2:ResourceTag/ManagedBy": "terraform"
        },
        "ForAllValues:StringNotEquals": {
          "aws:TagKeys": [
            "Project",
            "ManagedBy"
          ]
        }
      }
    },
    {
      "Sid": "ReadLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ManageClusterLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/eks/fiapx/cluster",
        "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/eks/fiapx/cluster:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "UseExactNodeLaunchDependencies",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:volume/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:network-interface/*",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:subnet/PRIVATE_SUBNET_A_ID",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:subnet/PRIVATE_SUBNET_B_ID",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:security-group/EKS_CLUSTER_SECURITY_GROUP_ID",
        "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/EKS_LAUNCH_TEMPLATE_ID"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-1" },
        "ArnEquals": { "ec2:LaunchTemplate": "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/EKS_LAUNCH_TEMPLATE_ID" }
      }
    },
    {
      "Sid": "LaunchConfiguredNodeTypes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:InstanceType": ["m6i.large", "m6a.large", "m5.large"],
          "ec2:MetadataHttpTokens": "required"
        },
        "ArnEquals": { "ec2:LaunchTemplate": "arn:aws:ec2:us-east-1:ACCOUNT_ID:launch-template/EKS_LAUNCH_TEMPLATE_ID" }
      }
    },
    {
      "Sid": "TagNodesAndVolumesAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": ["arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*", "arn:aws:ec2:us-east-1:ACCOUNT_ID:volume/*"],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:CreateAction": "RunInstances",
          "aws:RequestTag/Project": "fiapx",
          "aws:RequestTag/ManagedBy": "terraform"
        }
      }
    }
  ]
}
